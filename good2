<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nazr Quran Center</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            font-family: system-ui, sans-serif;
        }
        #content-wrapper {
            width: 100%;
            height: 100%;
        }
        /* Injecting global fallback styles to target the injected script element */
        .base44-watermark, 
        [class*="watermark"], 
        a[href*="base44.app"] {
            display: none !important;
            opacity: 0 !important;
            visibility: hidden !important;
        }
    </style>
</head>
<body>

    <div id="content-wrapper">Loading secure interface...</div>

    <script>
        const targetUrl = 'https://nazr-quran-center.base44.app/';
        // Using an open proxy to fetch the raw site data bypassing iframe restrictions
        const proxyUrl = 'https://api.allorigins.win/get?url=' + encodeURIComponent(targetUrl);

        fetch(proxyUrl)
            .then(response => {
                if (response.ok) return response.json();
                throw new Error('Network response error.');
            })
            .then(data => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(data.contents, 'text/html');

                // 1. Surgical Strike: Find and completely erase the specific watermark elements
                const badges = doc.querySelectorAll('.base44-watermark, [class*="watermark"], a[href*="base44.app"]');
                badges.forEach(badge => badge.remove());

                // 2. Fix asset links so images/styles load from base44 relative paths correctly
                const baseElement = doc.createElement('base');
                baseElement.href = targetUrl;
                doc.head.insertBefore(baseElement, doc.head.firstChild);

                // 3. Inject the clean document directly into the viewport
                document.getElementById('content-wrapper').innerHTML = doc.documentElement.innerHTML;
            })
            .catch(err => {
                console.error('Proxy fetch failed:', err);
                document.getElementById('content-wrapper').innerHTML = 
                    `<p style="padding:20px; text-align:center;">Failed to safely inject clean layout. Please use the Code Export method.</p>`;
            });
    </script>
</body>
</html>
